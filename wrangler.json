{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ah13-store",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":true},
