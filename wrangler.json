{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ah13-store",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./.assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ah13-store-db",
      "database_id": "e4c115f0-dc1b-4662-ba1f-783b2d418612"
    }
  ],
  "vars": {
    "APP_NAME": "AH13 Store"
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1301",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "build": {
    "command": "node build.mjs"
  }
}
